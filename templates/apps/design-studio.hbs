<section class="nexus-design-studio-shell" data-design-studio>
  <header class="nexus-design-studio-toolbar">
    <div class="nexus-design-studio-identity">
      <span class="nexus-design-studio-mark"><i class="fa-solid fa-palette" aria-hidden="true"></i></span>
      <div><strong>Estúdio de Aparência</strong><small>Personalize a identidade visual sem alterar dados da campanha.</small></div>
    </div>
    <div class="nexus-design-studio-target">
      <label for="nexus-design-target">Aplicar em</label>
      <select id="nexus-design-target" data-design-target>
        {{#each targetOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
      <button type="button" data-design-action="target" title="Carregar perfil do destino"><i class="fa-solid fa-arrow-right-arrow-left" aria-hidden="true"></i></button>
    </div>
  </header>

  <div class="nexus-design-studio-body">
    <nav class="nexus-design-studio-nav" aria-label="Seções do editor" role="tablist">
      <button type="button" class="is-active" id="nexus-design-tab-palette" data-design-section="palette" role="tab" aria-controls="nexus-design-palette" aria-selected="true" aria-pressed="true">Paleta</button>
      <button type="button" id="nexus-design-tab-typography" data-design-section="typography" role="tab" aria-controls="nexus-design-typography" aria-selected="false" aria-pressed="false">Tipografia</button>
      <button type="button" id="nexus-design-tab-layout" data-design-section="layout" role="tab" aria-controls="nexus-design-layout" aria-selected="false" aria-pressed="false">Layout</button>
      <button type="button" id="nexus-design-tab-accessibility" data-design-section="accessibility" role="tab" aria-controls="nexus-design-accessibility" aria-selected="false" aria-pressed="false">Acessibilidade</button>
    </nav>

    <main class="nexus-design-studio-editor">
      <section class="nexus-design-studio-section" id="nexus-design-palette" data-design-section-panel="palette" role="tabpanel" aria-labelledby="nexus-design-tab-palette">
        <div class="nexus-design-section-heading"><div><h3>Paleta de cores</h3><p>Escolha um preset como ponto de partida e ajuste cada superfície individualmente.</p></div></div>
        <label class="nexus-design-field"><span>Nome do perfil</span><input type="text" maxlength="64" value="{{profile.name}}" data-design-path="name"></label>
        <label class="nexus-design-field nexus-design-preset">
          <span>Preset base</span>
          <select data-design-preset>
            {{#each presetChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </label>
        <div class="nexus-design-color-grid">
          {{#each paletteFields}}
          <label class="nexus-design-color-field">
            <span>{{label}}</span>
            <input type="color" data-design-path="palette.{{key}}" value="{{value}}" aria-label="{{label}}">
            <code>{{value}}</code>
          </label>
          {{/each}}
        </div>
      </section>

      <section class="nexus-design-studio-section" id="nexus-design-typography" data-design-section-panel="typography" role="tabpanel" aria-labelledby="nexus-design-tab-typography" hidden>
        <div class="nexus-design-section-heading"><div><h3>Tipografia</h3><p>Controle a família tipográfica e a hierarquia de leitura.</p></div></div>
        <div class="nexus-design-settings-grid">
          <label class="nexus-design-field"><span>Família tipográfica</span><select data-design-path="typography.family">{{#each fontChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <label class="nexus-design-field"><span>Tamanho principal <output data-design-output="typography.baseSize">{{profile.typography.baseSize}}</output> px</span><input type="range" min="11" max="18" step="1" value="{{profile.typography.baseSize}}" data-design-path="typography.baseSize"></label>
          <label class="nexus-design-field"><span>Texto secundário <output data-design-output="typography.secondarySize">{{profile.typography.secondarySize}}</output> px</span><input type="range" min="9" max="16" step="1" value="{{profile.typography.secondarySize}}" data-design-path="typography.secondarySize"></label>
          <label class="nexus-design-field"><span>Valores destacados <output data-design-output="typography.valueSize">{{profile.typography.valueSize}}</output> px</span><input type="range" min="14" max="28" step="1" value="{{profile.typography.valueSize}}" data-design-path="typography.valueSize"></label>
          <label class="nexus-design-field"><span>Altura de linha <output data-design-output="typography.lineHeight">{{profile.typography.lineHeight}}</output></span><input type="range" min="1.2" max="1.8" step="0.05" value="{{profile.typography.lineHeight}}" data-design-path="typography.lineHeight"></label>
        </div>
        <div class="nexus-design-type-preview"><strong>O destino de NEXUS</strong><p>Uma interface clara ajuda a organizar informações, reconhecer prioridades e acompanhar a sessão sem competir com o conteúdo da ficha.</p><span>Texto auxiliar · Exemplo de hierarquia visual</span></div>
      </section>

      <section class="nexus-design-studio-section" id="nexus-design-layout" data-design-section-panel="layout" role="tabpanel" aria-labelledby="nexus-design-tab-layout" hidden>
        <div class="nexus-design-section-heading"><div><h3>Layout e densidade</h3><p>Ajuste o ritmo visual e o tamanho dos controles.</p></div></div>
        <div class="nexus-design-settings-grid">
          <label class="nexus-design-field"><span>Densidade</span><select data-design-path="layout.density">{{#each densityChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <label class="nexus-design-field"><span>Formato dos cantos</span><select data-design-path="layout.radius">{{#each radiusChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <label class="nexus-design-field"><span>Espaçamento <output data-design-output="layout.spacing">{{profile.layout.spacing}}</output>×</span><input type="range" min="0.75" max="1.5" step="0.05" value="{{profile.layout.spacing}}" data-design-path="layout.spacing"></label>
          <label class="nexus-design-field"><span>Altura dos controles <output data-design-output="layout.controlHeight">{{profile.layout.controlHeight}}</output> px</span><input type="range" min="28" max="44" step="1" value="{{profile.layout.controlHeight}}" data-design-path="layout.controlHeight"></label>
        </div>
      </section>

      <section class="nexus-design-studio-section" id="nexus-design-accessibility" data-design-section-panel="accessibility" role="tabpanel" aria-labelledby="nexus-design-tab-accessibility" hidden>
        <div class="nexus-design-section-heading"><div><h3>Acessibilidade</h3><p>Verificações de contraste são recomendações; o perfil continua editável.</p></div></div>
        <div class="nexus-design-settings-grid">
          <label class="nexus-design-field"><span>Nível de contraste</span><select data-design-path="accessibility.contrast">{{#each contrastChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <label class="nexus-design-check"><input type="checkbox" data-design-path="accessibility.reducedMotion" {{#if profile.accessibility.reducedMotion}}checked{{/if}}><span>Reduzir animações e transições</span></label>
        </div>
        <ul class="nexus-design-diagnostics" data-design-diagnostics>
          {{#each diagnostics.checks}}<li class="{{#if passes}}is-valid{{else}}is-warning{{/if}}">{{label}} — {{ratio}}:1</li>{{/each}}
        </ul>
        <p class="{{#if warnings.length}}nexus-design-warning{{else}}nexus-design-success{{/if}}" data-design-diagnostics-message>{{#if warnings.length}}<i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> Alguns pares de cores precisam de mais contraste. Revise a paleta antes de compartilhar.{{else}}<i class="fa-solid fa-check" aria-hidden="true"></i> Os pares de texto avaliados atendem ao contraste selecionado.{{/if}}</p>
      </section>
    </main>

    <aside class="nexus-design-studio-preview">
      <div class="nexus-design-preview-heading"><strong>Pré-visualização</strong><span>Ao vivo · somente neste cliente</span></div>
      <div class="nexus-design-preview-card">
        <div class="nexus-design-preview-top"><span class="nexus-design-preview-dot"></span><span>FICHA NEXUS</span><i class="fa-solid fa-ellipsis" aria-hidden="true"></i></div>
        <div class="nexus-design-preview-content">
          <small>PERSONAGEM</small><h3>Guardião do Limiar</h3><p>Explorador · Nível 4</p>
          <div class="nexus-design-preview-stats"><div><small>PV</small><strong>24 / 30</strong></div><div><small>PM</small><strong>12 / 16</strong></div></div>
          <div class="nexus-design-preview-progress"><span></span></div>
          <div class="nexus-design-preview-actions"><button type="button">Ação principal</button><button type="button">Detalhes</button></div>
        </div>
        <div class="nexus-design-preview-components" aria-label="Prévia dos componentes do tema">
          <section class="nexus-design-preview-sample">
            <small class="nexus-design-preview-label">PAINEL E CONTAINER</small>
            <div class="nexus-design-sample-panel"><strong>Resumo do personagem</strong><div class="nexus-design-sample-container"><span>Experiência</span><b>1.250 XP</b></div></div>
          </section>
          <section class="nexus-design-preview-sample">
            <small class="nexus-design-preview-label">BOTÕES</small>
            <div class="nexus-design-sample-buttons"><button type="button">Ação</button><button type="button" class="is-secondary">Cancelar</button></div>
          </section>
          <section class="nexus-design-preview-sample">
            <small class="nexus-design-preview-label">TIPOGRAFIA E INPUTS</small>
            <div class="nexus-design-sample-type">
              <strong>Título de seção</strong>
              <span>Texto auxiliar e descrição de exemplo</span>
              <input type="text" value="Campo de texto demonstrativo" readonly aria-label="Prévia de campo de texto">
              <select aria-label="Prévia de seleção" tabindex="-1"><option>Opção selecionada</option></select>
              <textarea rows="2" readonly aria-label="Prévia de área de texto">Texto em uma área de edição</textarea>
            </div>
          </section>
          <section class="nexus-design-preview-sample">
            <small class="nexus-design-preview-label">BARRA DE ROLAGEM</small>
            <div class="nexus-design-sample-scroll"><span>Inventário</span><span>Equipamentos</span><span>Habilidades</span><span>Condições</span><span>Histórico</span></div>
          </section>
        </div>
      </div>
      <p class="nexus-design-preview-note">A prévia não salva alterações. Fechar o estúdio descarta um rascunho não salvo.</p>

      {{#if hasDesignLibrary}}
      <section class="nexus-design-library-panel" aria-label="Biblioteca de aparências">
        <div class="nexus-design-library-heading"><div><strong>Biblioteca de aparências</strong><small>Perfis reutilizáveis da sua coleção pessoal</small></div><span>{{libraryProfiles.length}}</span></div>
        {{#if libraryUnavailable}}<p class="nexus-design-library-empty">A Biblioteca está indisponível no momento; a edição e a prévia continuam funcionando.</p>{{/if}}
        <button type="button" class="nexus-design-library-save" data-design-action="save-library"><i class="fa-solid fa-bookmark" aria-hidden="true"></i> Salvar rascunho na Biblioteca</button>
        {{#if libraryProfiles.length}}
          <div class="nexus-design-library-list">
            {{#each libraryProfiles}}
            <article class="nexus-design-library-entry" data-design-profile-row>
              <div class="nexus-design-library-entry-heading"><strong>{{name}}</strong><small>{{preset}} · {{updatedAt}}</small></div>
              <input type="text" maxlength="64" value="{{name}}" data-design-rename-input aria-label="Novo nome de {{name}}">
              <div class="nexus-design-library-entry-actions">
                <button type="button" data-design-action="load-library" data-profile-id="{{id}}">Carregar</button>
                <button type="button" data-design-action="apply-library" data-profile-id="{{id}}">Aplicar</button>
                <button type="button" data-design-action="duplicate-library" data-profile-id="{{id}}" title="Duplicar"><i class="fa-solid fa-copy" aria-hidden="true"></i></button>
                <button type="button" data-design-action="rename-library" data-profile-id="{{id}}" title="Renomear"><i class="fa-solid fa-pen" aria-hidden="true"></i></button>
                <button type="button" data-design-action="export-library" data-profile-id="{{id}}" title="Exportar"><i class="fa-solid fa-file-export" aria-hidden="true"></i></button>
                <button type="button" data-design-action="delete-library" data-profile-id="{{id}}" title="Excluir"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
              </div>
            </article>
            {{/each}}
          </div>
        {{else}}
          <p class="nexus-design-library-empty">Nenhum perfil salvo. Personalize a aparência e salve uma cópia para reutilizar depois.</p>
        {{/if}}
      </section>
      {{/if}}
    </aside>
  </div>

  <footer class="nexus-design-studio-footer">
    <div class="nexus-design-studio-file-actions">
      <button type="button" data-design-action="import"><i class="fa-solid fa-file-import" aria-hidden="true"></i> Importar</button>
      <button type="button" data-design-action="export"><i class="fa-solid fa-file-export" aria-hidden="true"></i> Exportar</button>
      <button type="button" data-design-action="reset"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Restaurar preset</button>
    </div>
    <div class="nexus-design-studio-save-actions">
      <button type="button" data-design-action="discard">Descartar</button>
      <button type="button" class="nexus-design-save" data-design-action="save"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Salvar aparência</button>
    </div>
  </footer>
</section>
