                        <label>Nome real<input type="text" value="{{nexus.selectedNativeProperty.currentValue}}" data-native-property-field="currentValue"></label>
                      {{else if (eq nexus.selectedNativeProperty.type "number")}}
                        <label>Valor<input type="number" value="{{nexus.selectedNativeProperty.currentValue}}" data-native-property-field="currentValue"></label>
                      {{else if (eq nexus.selectedNativeProperty.type "boolean")}}
                        <label>Valor<select data-native-property-field="currentValue"><option value="true" {{#if nexus.selectedNativeProperty.currentValue}}selected{{/if}}>Sim</option><option value="false" {{#unless nexus.selectedNativeProperty.currentValue}}selected{{/unless}}>Não</option></select></label>
                      {{else}}
                        <label>Valor<input type="text" value="{{nexus.selectedNativeProperty.currentValue}}" data-native-property-field="currentValue"></label>
                      {{/if}}
                    </div>
                    {{#if (eq nexus.selectedNativeProperty.type "attribute")}}
