                    {{#if (eq component.sheetVariant "name")}}{{#if (eq nexus.mode "config")}}{{#if (ne component.updateSource false)}}<input class="nexus-config-inline-field" type="text" data-system-path="{{component.path}}" value="{{component.value}}" aria-label="Editar valor vinculado">{{else}}<strong>{{component.value}}</strong>{{/if}}{{else}}<strong>{{component.value}}</strong>{{/if}}
                    {{else if (eq component.sheetVariant "level")}}{{#if (eq nexus.mode "config")}}<input type="number" class="nexus-config-inline-field" data-system-path="{{component.path}}" value="{{component.value}}" aria-label="Nível">{{else}}<strong>{{#if component.path}}{{component.value}}{{else}}1{{/if}}</strong>{{/if}}
                    {{else if (eq component.sheetVariant "lineage")}}<small>LINHAGEM</small>{{#if (eq nexus.mode "config")}}<input type="text" class="nexus-config-inline-field" data-system-path="{{component.path}}" value="{{component.value}}" aria-label="Linhagem">{{else}}<strong>{{#if component.path}}{{component.value}}{{else}}{{component.text}}{{/if}}</strong>{{/if}}
                    {{else if (eq component.sheetVariant "physiognomy")}}<small>FISIONOMIA</small>{{#if (eq nexus.mode "config")}}<input type="text" class="nexus-config-inline-field" data-config-component-text value="{{component.text}}" aria-label="Fisionomia" data-component-id="{{component.id}}">{{else}}<strong>{{#if component.path}}{{component.value}}{{else}}{{component.text}}{{/if}}</strong>{{/if}}
                    {{else if (eq component.sheetVariant "legacy")}}<small>LEGADO</small>{{#if (eq nexus.mode "config")}}<input type="text" class="nexus-config-inline-field" data-system-path="{{component.path}}" value="{{component.value}}" aria-label="Legado">{{else}}<strong>{{#if component.path}}{{component.value}}{{else}}{{component.text}}{{/if}}</strong>{{/if}}
                    {{else if (eq component.sheetVariant "resource")}}<div class="nexus-sheet-resource nexus-sheet-resource-preview {{#if (eq component.sheetOrientation "vertical")}}is-vertical{{/if}}" style="--nexus-resource-color:{{component.sheetColor}};--nexus-resource-track-color:{{component.sheetTrackColor}}">{{#if component.sheetContent1}}<span class="nexus-sheet-resource-label">{{#if component.sheetContent1IsImage}}<img src="{{component.sheetContent1}}" alt="">{{else}}{{component.sheetContent1}}{{/if}}</span>{{/if}}{{#if component.sheetContent2}}<span class="nexus-sheet-resource-icon">{{#if component.sheetContent2IsImage}}<img src="{{component.sheetContent2}}" alt="">{{else}}{{component.sheetContent2}}{{/if}}</span>{{/if}}<div class="nexus-sheet-resource-track"><i style="{{#if (eq component.sheetOrientation "vertical")}}--nexus-resource-percent:{{component.percent}}%;height:{{component.percent}}%;width:100%{{else}}width:{{component.percent}}%;height:100%{{/if}}"></i></div>{{#if (eq nexus.mode "config")}}<strong class="nexus-sheet-resource-values"><input type="number" min="0" data-system-path="{{component.currentPath}}" value="{{component.value}}" aria-label="Valor atual"><span>/</span><input type="number" min="0" data-system-path="{{component.maxPath}}" value="{{component.max}}" aria-label="Valor máximo"></strong>{{else}}<strong class="nexus-sheet-resource-values">{{component.value}} <span>/ {{component.max}}</span></strong>{{/if}}</div>
                    {{else if (eq component.sheetVariant "derived")}}{{#if (eq nexus.mode "config")}}<input type="text" class="nexus-config-inline-field" data-config-component-code data-component-id="{{component.id}}" value="{{component.sheetCode}}" aria-label="Rótulo do indicador">{{else}}<small>{{component.sheetCode}}</small>{{/if}}<strong>{{#if component.path}}{{component.value}}{{else}}—{{/if}}</strong>
                    {{else if (eq component.sheetVariant "attribute")}}{{#if (eq nexus.mode "config")}}<input type="number" class="nexus-config-inline-field" data-system-path="{{component.path}}" value="{{component.value}}" aria-label="Valor do atributo">{{else}}<strong>{{#if component.path}}{{component.value}}{{else}}0{{/if}}</strong>{{/if}}
                    {{else if (eq component.sheetVariant "skill")}}<span class="nexus-sheet-skill-code">{{component.sheetCode}}</span><strong>{{component.text}}</strong><b>{{#if component.path}}{{component.value}}{{else}}+0{{/if}}</b>
                    {{else if (eq component.sheetVariant "skill-group")}}<div class="nexus-skill-table-heading">{{#if (eq nexus.mode "config")}}<input type="text" class="nexus-config-inline-field" data-config-component-text data-component-id="{{component.id}}" value="{{component.text}}" aria-label="Título do grupo de perícias">{{else}}<strong>{{component.text}}</strong>{{/if}}<span>{{component.skillRows.length}}</span></div><div class="nexus-skill-table">{{#each component.skillRows as |skill|}}<div class="nexus-skill-row"><button type="button" class="nexus-skill-roll" data-skill-roll="{{skill.key}}" aria-label="Rolar {{skill.name}}" {{#if (eq nexus.mode "config")}}disabled{{/if}}><span class="nexus-sheet-skill-code">{{skill.attribute}}</span><strong>{{skill.name}}</strong></button><b class="nexus-skill-value">{{skill.value}}</b><input type="number" class="nexus-skill-proficiency-level {{#if skill.proficient}}is-proficient{{/if}}" data-skill-proficient-level="{{skill.key}}" value="{{skill.proficientLevel}}" min="-1" max="1" step="1" aria-label="Nível de proficiência em {{skill.name}}" {{#if (eq nexus.mode "config")}}disabled{{/if}}></div>{{/each}}</div>
                    {{else if (eq component.sheetVariant "action-attack")}}<b class="nexus-sheet-action-symbol">◎</b><strong>ATAQUES</strong><small>Espaço para ações ofensivas</small>
                    {{else if (eq component.sheetVariant "action-general")}}<b class="nexus-sheet-action-symbol">↗</b><strong>AÇÕES</strong><small>Espaço para ações gerais</small>
                    {{else if (eq component.sheetVariant "action-reaction")}}<b class="nexus-sheet-action-symbol">↶</b><strong>REAÇÕES</strong><small>Espaço para respostas</small>
                    {{else if (eq component.sheetVariant "section")}}{{#if (eq nexus.mode "config")}}<input type="text" class="nexus-config-inline-field" data-config-component-text data-component-id="{{component.id}}" value="{{component.text}}" aria-label="Título da seção">{{else}}<strong>{{component.text}}</strong>{{/if}}<i></i>{{/if}}
                  </div>
                {{else if (eq component.kind "asset-text")}}{{#if (eq nexus.mode "config")}}<input type="text" class="nexus-config-inline-field" data-config-component-text data-component-id="{{component.id}}" value="{{component.text}}" aria-label="Texto">{{else}}<div class="nexus-asset-text">{{#if component.path}}{{component.value}}{{else}}{{component.text}}{{/if}}</div>{{/if}}
                {{else if (eq component.kind "asset-value")}}<div class="nexus-asset-value">{{#if component.path}}{{component.value}}{{else}}—{{/if}}</div>{{#unless component.path}}{{/unless}}
                {{else if (eq component.kind "asset-field")}}<input class="nexus-asset-field" type="text" {{#if component.path}}data-system-path="{{component.path}}" value="{{component.value}}"{{else}}data-component-local-value data-component-id="{{component.id}}" value="{{component.localValue}}"{{/if}}>
                {{else if (eq component.kind "asset-meter")}}{{#if (eq component.format "ring")}}{{#if component.path}}<div class="nexus-resource-ring" style="--nexus-resource-percent:{{component.percent}}%"><div class="nexus-resource-ring-values"><strong>{{component.value}}</strong><span>/ {{component.max}}</span></div></div>{{else}}<div class="nexus-resource-ring nexus-resource-unbound"></div>{{/if}}{{else if (eq component.format "classic")}}{{#if component.path}}<div class="nexus-resource-values"><strong>{{component.value}}</strong><span>/</span><strong>{{component.max}}</strong></div>{{else}}<div class="nexus-resource-values nexus-resource-unbound"><strong>—</strong><span>/</span><strong>—</strong></div>{{/if}}{{else}}{{#if component.path}}<div class="nexus-asset-meter"><div class="nexus-asset-meter-fill" style="width:{{component.percent}}%"></div></div><div class="nexus-resource-bar-values"><strong>{{component.value}}</strong><span>/ {{component.max}}</span></div>{{else}}<div class="nexus-asset-meter"><div class="nexus-asset-meter-fill" style="width:0%"></div></div>{{/if}}{{/if}}
                {{else if (eq component.kind "asset-table")}}<div class="nexus-asset-table" style="--nexus-table-columns:{{component.columns}};--nexus-table-rows:{{component.rows}}">{{#each component.tableCells}}<input class="nexus-table-cell" type="text" data-table-cell="{{this.index}}" value="{{this.value}}" aria-label="Célula da tabela">{{/each}}</div>
                {{else if (eq component.kind "asset-notes")}}<textarea class="nexus-asset-notes" {{#if component.path}}data-system-path="{{component.path}}"{{else}}data-component-local-value data-component-id="{{component.id}}"{{/if}}>{{#if component.path}}{{component.value}}{{else}}{{component.localValue}}{{/if}}</textarea>
                {{else if (eq component.kind "asset-image")}}<img class="nexus-asset-image" src="{{component.value}}" alt="Imagem do personagem" loading="lazy" style="object-fit:{{component.imageFit}};object-position:{{component.imagePosition}};opacity:{{component.imageOpacity}}%">
                {{else if (eq component.kind "asset-link")}}{{#if component.safeLink}}<a class="nexus-asset-link" href="{{component.safeLink}}" target="_blank" rel="noopener noreferrer">{{#if component.customLabel}}{{component.customLabel}}{{else}}Abrir link{{/if}}</a>{{else}}{{/if}}
                {{else if (eq component.kind "text-field")}}<input type="text" {{#if component.path}}data-system-path="{{component.path}}" value="{{component.value}}"{{else}}data-component-local-value data-component-id="{{component.id}}" value="{{component.localValue}}"{{/if}}>
                {{else if (eq component.kind "table")}}<div class="nexus-asset-table"><span></span><span></span><span></span><span></span><span></span><span></span></div>
                {{else if (eq component.kind "name")}}{{#if (eq nexus.mode "config")}}<input type="text" data-system-path="name" value="{{component.value}}">{{else}}<strong>{{component.value}}</strong>{{/if}}
                {{else if (eq component.kind "number")}}{{#if (eq nexus.mode "config")}}<input type="number" data-system-path="{{component.path}}" value="{{component.value}}">{{else}}<strong>{{component.value}}</strong>{{/if}}
                {{else}}<input type="text" data-system-path="{{component.path}}" value="{{component.value}}">{{/if}}
              </div>
              {{#if (eq ../nexus.mode "play")}}
                {{#if component.showResourceSlider}}<div class="nexus-resource-slider-control"><input type="range" min="0" max="{{component.max}}" step="1" value="{{component.value}}" data-resource-slider data-system-path="{{component.sliderPath}}" aria-label="Ajustar {{component.label}}"></div>{{/if}}
                {{#if (eq component.actionType "proficiency")}}<div class="nexus-proficiency-control" role="group" aria-label="Nível de domínio">{{#each component.proficiencyStages}}<button type="button" data-proficiency-level="{{this.level}}" class="{{#if this.active}}is-active{{/if}}" aria-pressed="{{this.active}}">{{this.label}}</button>{{/each}}</div>{{/if}}
              {{/if}}

              {{#if (eq ../nexus.mode "appearance")}}
              {{/if}}
            </article>
          {{/each}}
        </div>
      </div>
    </main>

    <aside class="nexus-sidebar nexus-sidebar-right" aria-label="Navegação de layouts">
      <div class="nexus-layout-tabs">
        {{#each nexus.layouts as |layout|}}
          <div class="nexus-layout-tab-item">
            <button type="button" class="nexus-layout-tab {{#if (eq layout.id ../nexus.layout.id)}}active{{/if}}" data-layout-tab data-layout-id="{{layout.id}}" aria-label="{{layout.name}}">
              {{#if (eq layout.tabMode "icon")}}<i class="{{layout.tabIcon}}" aria-hidden="true"></i>
              {{else if (eq layout.tabMode "image")}}{{#if layout.tabImage}}<img src="{{layout.tabImage}}" alt="">{{else}}<span class="nexus-layout-tab-label">{{layout.name}}</span>{{/if}}
              {{else if (eq layout.tabMode "number")}}<span class="nexus-layout-tab-label">{{layout.tabValue}}</span>
              {{else}}<span class="nexus-layout-tab-label">{{#if layout.tabValue}}{{layout.tabValue}}{{else}}{{layout.name}}{{/if}}</span>{{/if}}
            </button>
          </div>
        {{/each}}
      </div>
      {{#if (eq nexus.mode "appearance")}}<button type="button" class="nexus-add-layout-tab" data-action="new-layout">＋</button>{{/if}}

    </aside>
  </section>
</form>
