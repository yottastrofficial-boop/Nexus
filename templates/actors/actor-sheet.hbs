    <main class="nexus-canvas-stage">
      <div class="nexus-canvas-scroll">
        <div class="nexus-canvas" data-grid-size="{{nexus.layout.gridSize}}" data-layout-width="{{nexus.layout.width}}" data-layout-height="{{nexus.layout.height}}" data-grid="{{nexus.layout.gridEnabled}}" data-snap="{{nexus.layout.snapEnabled}}" data-guides="{{nexus.layout.guidesEnabled}}" style="width:{{nexus.layout.width}}px;height:{{nexus.layout.height}}px;--nexus-grid-size:{{nexus.layout.gridSize}}px;--nexus-canvas-color:{{nexus.layout.canvasColor}};--nexus-card-color:{{nexus.layout.cardColor}};--nexus-accent-color:{{nexus.layout.accentColor}}">
          <div class="nexus-guides"></div><div class="nexus-marquee" hidden></div>
          {{#each nexus.rendered as |component|}}
            <article class="nexus-component {{#if component.hidden}}is-layer-hidden{{/if}} {{#if component.locked}}is-locked{{/if}} {{#if component.hasClickInteraction}}is-rollable is-actionable{{/if}}" data-id="{{component.id}}" data-type="{{component.type}}" data-action-type="{{component.actionType}}" data-has-click-interaction="{{component.hasClickInteraction}}" {{#if component.hasClickInteraction}}tabindex="0" role="button" aria-label="Executar interação do componente"{{/if}} {{#if component.hidden}}hidden{{/if}} data-label-position="{{component.labelPosition}}" style="left:{{component.x}}px;top:{{component.y}}px;width:{{component.w}}px;height:{{component.h}}px;z-index:{{component.renderZ}};--nexus-layer:{{component.renderZ}};--nexus-component-font-size:{{component.fontSize}}px;--nexus-component-font-family:{{component.fontFamily}};--nexus-component-text-align:{{component.textAlign}};--nexus-component-font-weight:{{component.fontWeight}};--nexus-component-font-style:{{component.fontStyle}};--nexus-component-text-transform:{{component.textTransform}};--nexus-component-letter-spacing:{{component.letterSpacing}}px;--nexus-component-line-height:{{component.lineHeight}};{{#if component.resourceColor}}--nexus-resource-color:{{component.resourceColor}};{{/if}}{{#if component.backgroundColor}}--nexus-component-bg:{{component.backgroundColor}};{{/if}}{{#if component.borderColor}}--nexus-component-border:{{component.borderColor}};{{/if}}{{#if component.hasBorderRadius}}--nexus-component-radius:{{component.borderRadius}}px;{{/if}}{{#if component.hasOpacity}}--nexus-component-opacity:{{component.opacity}}%;{{/if}}">
              {{#if component.showCardHeading}}<div class="nexus-component-heading" style="font-size:{{component.headingStyle.fontSize}}px;font-family:{{component.headingStyle.fontFamily}};color:{{component.headingStyle.color}};text-align:{{component.headingStyle.textAlign}};font-weight:{{component.headingStyle.fontWeight}};font-style:{{component.headingStyle.fontStyle}};text-decoration:{{component.headingStyle.textDecoration}};text-transform:{{component.headingStyle.textTransform}};letter-spacing:{{component.headingStyle.letterSpacing}}px;line-height:{{component.headingStyle.lineHeight}}">{{component.headingLabel}}</div>{{/if}}
              <div class="nexus-component-content" style="font-size:{{component.contentStyle.fontSize}}px;font-family:{{component.contentStyle.fontFamily}};color:{{component.contentStyle.color}};text-align:{{component.contentStyle.textAlign}};font-weight:{{component.contentStyle.fontWeight}};font-style:{{component.contentStyle.fontStyle}};text-decoration:{{component.contentStyle.textDecoration}};text-transform:{{component.contentStyle.textTransform}};letter-spacing:{{component.contentStyle.letterSpacing}}px;line-height:{{component.contentStyle.lineHeight}}">
                
                {{#if (eq component.kind "token")}}<div class="nexus-token-subcanvas" data-shape="{{component.tokenShape}}">{{#if component.tokenImageVideo}}<video class="nexus-token-portrait" src="{{component.value}}" autoplay muted loop playsinline aria-label="Token de {{actor.name}}"></video>{{else}}<img class="nexus-token-portrait" src="{{component.value}}" alt="Token de {{actor.name}}">{{/if}}</div>
                {{else if (eq component.kind "resource")}}
                  <div class="nexus-resource-values">{{#if (eq nexus.mode "config")}}<input type="number" data-system-path="{{component.path}}.value" value="{{component.value}}" aria-label="Valor atual de {{component.label}}"><span>/</span><input type="number" data-system-path="{{component.path}}.max" value="{{component.max}}" aria-label="Valor máximo de {{component.label}}">{{else}}<strong>{{component.value}}</strong><span>/</span><strong>{{component.max}}</strong>{{/if}}</div>
                  {{#if (eq nexus.mode "config")}}<div class="nexus-resource-actions"><button type="button" data-action="resource-adjust" data-path="{{component.path}}" data-delta="-1">−</button><button type="button" data-action="resource-adjust" data-path="{{component.path}}" data-delta="1">+</button></div>{{/if}}
                {{else if (eq component.kind "resource-bar")}}
                  <div class="nexus-resource-bar"><div class="nexus-resource-bar-fill" style="width:{{component.percent}}%"></div></div><div class="nexus-resource-bar-values">{{#if (eq nexus.mode "config")}}<input type="number" data-system-path="{{component.path}}.value" value="{{component.value}}" aria-label="Valor atual de {{component.label}}"><span>/</span><input type="number" data-system-path="{{component.path}}.max" value="{{component.max}}" aria-label="Valor máximo de {{component.label}}">{{else}}<strong>{{component.value}}</strong><span>/ {{component.max}}</span>{{/if}}</div>
                {{else if (eq component.kind "resource-meter")}}
                  {{#if component.path}}
                    {{#if (eq component.format "ring")}}
                      <div class="nexus-resource-ring" style="--nexus-resource-percent:{{component.percent}}%"><div class="nexus-resource-ring-values">{{#if (eq nexus.mode "config")}}<input type="number" data-system-path="{{component.path}}.value" value="{{component.value}}" aria-label="Valor atual de {{component.label}}"><span>/</span><input type="number" data-system-path="{{component.path}}.max" value="{{component.max}}" aria-label="Valor máximo de {{component.label}}">{{else}}<strong>{{component.value}}</strong><span>/</span><strong>{{component.max}}</strong>{{/if}}</div></div>
                    {{else if (eq component.format "classic")}}
                      <div class="nexus-resource-values">{{#if (eq nexus.mode "config")}}<input type="number" data-system-path="{{component.path}}.value" value="{{component.value}}"><span>/</span><input type="number" data-system-path="{{component.path}}.max" value="{{component.max}}">{{else}}<strong>{{component.value}}</strong><span>/</span><strong>{{component.max}}</strong>{{/if}}</div>{{#if (eq nexus.mode "config")}}<div class="nexus-resource-actions"><button type="button" data-action="resource-adjust" data-path="{{component.path}}" data-delta="-1">−</button><button type="button" data-action="resource-adjust" data-path="{{component.path}}" data-delta="1">＋</button></div>{{/if}}
                    {{else}}
                      <div class="nexus-resource-bar"><div class="nexus-resource-bar-fill" style="width:{{component.percent}}%"></div></div><div class="nexus-resource-bar-values">{{#if (eq nexus.mode "config")}}<input type="number" data-system-path="{{component.path}}.value" value="{{component.value}}"><span>/</span><input type="number" data-system-path="{{component.path}}.max" value="{{component.max}}">{{else}}<strong>{{component.value}}</strong><span>/ {{component.max}}</span>{{/if}}</div>
                    {{/if}}
                  {{else}}
                    {{#if (eq component.format "ring")}}<div class="nexus-resource-ring nexus-resource-unbound"></div>
                    {{else if (eq component.format "classic")}}<div class="nexus-resource-values nexus-resource-unbound"><strong>—</strong><span>/</span><strong>—</strong></div>
                    {{else}}<div class="nexus-resource-bar"><div class="nexus-resource-bar-fill" style="width:0%"></div></div>{{/if}}
                    
                  {{/if}}
                {{else if (eq component.kind "resource-ring")}}
                  <div class="nexus-resource-ring" style="--nexus-resource-percent:{{component.percent}}%"><div class="nexus-resource-ring-values">{{#if (eq nexus.mode "config")}}<input type="number" data-system-path="{{component.path}}.value" value="{{component.value}}" aria-label="Valor atual de {{component.label}}"><span>/</span><input type="number" data-system-path="{{component.path}}.max" value="{{component.max}}" aria-label="Valor máximo de {{component.label}}">{{else}}<strong>{{component.value}}</strong><span>/</span><strong>{{component.max}}</strong>{{/if}}</div></div>
                {{else if (eq component.kind "custom")}}
                  {{#if component.hasContent}}<div class="nexus-custom-card-value">{{component.value}}</div>{{/if}}
                {{else if (eq component.kind "sheet-element")}}
