                <label>Campo para editar<select data-alias-select>
                  {{#each nexus.aliases as |alias|}}<option value="{{alias.id}}" {{#if (eq nexus.selectedAlias.id alias.id)}}selected{{/if}}>{{alias.label}} · {{alias.key}}</option>{{/each}}
                </select></label>
                {{#if nexus.selectedAlias}}
                  <article class="nexus-alias-card" data-alias-row="{{nexus.selectedAlias.id}}">
                    <div class="nexus-alias-card-grid">
                      <label>Nome<input type="text" value="{{nexus.selectedAlias.label}}" data-alias-field="name"></label>
                      <label>Identificador<input type="text" value="{{nexus.selectedAlias.shortKey}}" data-alias-field="keySuffix" spellcheck="false"></label>
                    </div>
                    {{#if (eq nexus.selectedAlias.type "attribute")}}
                      <div class="nexus-alias-field-grid">
                        <label>Exibição<input type="text" value="{{nexus.selectedAlias.value.exibicao}}" data-alias-field="exibicao"></label>
                        <label>Valor<input type="number" value="{{nexus.selectedAlias.value.value}}" data-alias-field="value"></label>
                        <label>Bônus de rolagem<input type="text" value="{{nexus.selectedAlias.value.checkbonus}}" data-alias-field="checkbonus"></label>
                        <label>Fórmula<input type="text" value="{{nexus.selectedAlias.value.roll}}" data-alias-field="roll"></label>
                      </div>
                    {{else if (eq nexus.selectedAlias.type "resource")}}
                      <div class="nexus-alias-field-grid">
                        <label>Exibição<input type="text" value="{{nexus.selectedAlias.value.exibicao}}" data-alias-field="exibicao"></label>
                        <label>Atual<input type="number" value="{{nexus.selectedAlias.value.value}}" data-alias-field="value"></label>
                        <label>Máximo<input type="number" value="{{nexus.selectedAlias.value.max}}" data-alias-field="max"></label>
                        <label>Percentual<output>{{nexus.selectedAlias.percentage}}%</output></label>
                      </div>
                    {{else}}
                      <div class="nexus-alias-field-grid">
                        <label>Formato<select data-alias-field="valueType"><option value="number" {{#if (eq nexus.selectedAlias.type "number")}}selected{{/if}}>Numérico</option><option value="text" {{#if (eq nexus.selectedAlias.type "text")}}selected{{/if}}>Texto</option><option value="url" {{#if (eq nexus.selectedAlias.type "url")}}selected{{/if}}>Link</option><option value="image" {{#if (eq nexus.selectedAlias.type "image")}}selected{{/if}}>Imagem</option><option value="boolean" {{#if (eq nexus.selectedAlias.type "boolean")}}selected{{/if}}>Sim / não</option></select></label>
                        {{#if (eq nexus.selectedAlias.type "boolean")}}
                          <label class="nexus-alias-boolean">Valor<input type="checkbox" {{#if nexus.selectedAlias.scalarValue}}checked{{/if}} data-alias-field="value"></label>
                        {{else}}
                          <label>Valor<input type="{{#if (eq nexus.selectedAlias.type "number")}}number{{else}}text{{/if}}" value="{{nexus.selectedAlias.scalarValue}}" data-alias-field="value"></label>
                        {{/if}}
                      </div>
                    {{/if}}
                    <label class="nexus-alias-link">Vincular ao Actor (opcional)<input type="text" value="{{nexus.selectedAlias.targetPath}}" data-alias-field="targetPath" spellcheck="false"></label>
                    <div class="nexus-alias-card-actions">
                      <small>{{nexus.selectedAlias.key}}</small>
                      <div><button type="button" data-alias-copy>Copiar</button><button type="button" data-alias-reset>Restaurar</button><button type="button" class="nexus-danger-button" data-alias-delete>Excluir</button></div>
                    </div>
                  </article>
                {{else}}
