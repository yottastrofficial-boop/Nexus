<form class="nexus-sheet" data-mode="{{nexus.mode}}" autocomplete="off">

  <section class="nexus-workspace">
    <aside class="nexus-sidebar nexus-sidebar-left">
      {{#if (eq nexus.mode "appearance")}}
        <nav class="nexus-appearance-rail" aria-label="Ferramentas de aparência">
          <button type="button" data-appearance-panel="style" class="active" aria-label="Aparência"><i class="fa-solid fa-palette" aria-hidden="true"></i></button>
          <button type="button" data-appearance-panel="library" aria-label="Biblioteca"><i class="fa-solid fa-book-open" aria-hidden="true"></i></button>
          <button type="button" data-appearance-panel="layers" aria-label="Organização"><i class="fa-solid fa-layer-group" aria-hidden="true"></i></button>
          <button type="button" data-appearance-panel="aliases" aria-label="Estrutura de dados"><i class="fa-solid fa-diagram-project" aria-hidden="true"></i></button>
        </nav>
        <div class="nexus-appearance-drawer">
          <section class="nexus-tool-panel nexus-settings-panel" data-tool-panel="settings" hidden>
            <nav class="nexus-settings-rail" aria-label="Categorias de configurações">
              <button type="button" class="active" data-settings-section="organization" aria-label="Organização"><i class="fa-solid fa-grip" aria-hidden="true"></i></button>
            </nav>
            <div class="nexus-settings-drawer">
              <section class="nexus-settings-section active" data-settings-panel="organization">
                <h3>Organização</h3>
                <label class="nexus-check"><input type="checkbox" data-layout-setting="gridEnabled" {{#if nexus.layout.gridEnabled}}checked{{/if}}> Exibir grade</label>
                <label class="nexus-check"><input type="checkbox" data-layout-setting="snapEnabled" {{#if nexus.layout.snapEnabled}}checked{{/if}}> Encaixar na grade</label>
                <label>Tamanho da grade<input type="number" min="5" max="100" step="5" value="{{nexus.layout.gridSize}}" data-layout-setting="gridSize"></label>
                <label class="nexus-check"><input type="checkbox" data-layout-setting="guidesEnabled" {{#if nexus.layout.guidesEnabled}}checked{{/if}}> Alinhamento inteligente</label>
                <hr>
                <h4>Dimensões da ficha</h4>
                <label>Largura<input type="number" min="800" max="1000" step="10" value="{{nexus.layout.width}}" data-layout-setting="width"></label>
                <label>Altura<input type="number" min="300" max="3000" step="10" value="{{nexus.layout.height}}" data-layout-setting="height"></label>
              </section>
            </div>
          </section>
          <section class="nexus-tool-panel" data-tool-panel="style" hidden>
            <h3>Aparência global</h3>
            <label>Tema base<select data-layout-setting="theme"><option value="nexus-dark" {{#if (eq nexus.layout.theme "nexus-dark")}}selected{{/if}}>NEXUS escuro</option><option value="midnight" {{#if (eq nexus.layout.theme "midnight")}}selected{{/if}}>Meia-noite</option><option value="light" {{#if (eq nexus.layout.theme "light")}}selected{{/if}}>Claro</option><option value="steam" {{#if (eq nexus.layout.theme "steam")}}selected{{/if}}>Steam</option><option value="linux" {{#if (eq nexus.layout.theme "linux")}}selected{{/if}}>Linux Rice</option><option value="medieval" {{#if (eq nexus.layout.theme "medieval")}}selected{{/if}}>Medieval</option><option value="pixel-art" {{#if (eq nexus.layout.theme "pixel-art")}}selected{{/if}}>Pixel Art</option></select></label>
            <div class="nexus-global-color-grid">
              <label>Fundo da ficha<nexus-color-picker value="{{nexus.layout.canvasColor}}" data-layout-setting="canvasColor"></nexus-color-picker></label>
              <label>Cartões<nexus-color-picker value="{{nexus.layout.cardColor}}" data-layout-setting="cardColor"></nexus-color-picker></label>
              <label>Bordas<nexus-color-picker value="{{nexus.layout.accentColor}}" data-layout-setting="accentColor"></nexus-color-picker></label>
              <label>Destaque<nexus-color-picker value="{{nexus.layout.highlightColor}}" data-layout-setting="highlightColor"></nexus-color-picker></label>
              <label>Botões<nexus-color-picker value="{{nexus.layout.buttonColor}}" data-layout-setting="buttonColor"></nexus-color-picker></label>
            </div>
            <h4>Áreas da interface</h4>
            <div class="nexus-global-color-grid">
              <label>Área de rolagem<nexus-color-picker value="{{nexus.layout.scrollColor}}" data-layout-setting="scrollColor"></nexus-color-picker></label>
              <label>Cabeçalho das janelas<nexus-color-picker value="{{nexus.layout.windowHeaderColor}}" data-layout-setting="windowHeaderColor"></nexus-color-picker></label>
              <label>Conteúdo das janelas<nexus-color-picker value="{{nexus.layout.windowContentColor}}" data-layout-setting="windowContentColor"></nexus-color-picker></label>
              <label>Menus e listas<nexus-color-picker value="{{nexus.layout.menuColor}}" data-layout-setting="menuColor"></nexus-color-picker></label>
              <label>Texto de placeholder<nexus-color-picker value="{{nexus.layout.placeholderColor}}" data-layout-setting="placeholderColor"></nexus-color-picker></label>
            </div>
            <hr>
            <h3>Tipografia</h3>
            <label>Família tipográfica<select data-layout-setting="fontFamily"><option value="Inter" {{#if (eq nexus.layout.fontFamily "Inter")}}selected{{/if}}>Inter</option><option value="Arial" {{#if (eq nexus.layout.fontFamily "Arial")}}selected{{/if}}>Arial</option><option value="Georgia" {{#if (eq nexus.layout.fontFamily "Georgia")}}selected{{/if}}>Georgia</option><option value="Trebuchet MS" {{#if (eq nexus.layout.fontFamily "Trebuchet MS")}}selected{{/if}}>Trebuchet MS</option><option value="Verdana" {{#if (eq nexus.layout.fontFamily "Verdana")}}selected{{/if}}>Verdana</option><option value="monospace" {{#if (eq nexus.layout.fontFamily "monospace")}}selected{{/if}}>Monoespaçada</option></select></label>
            <label>Texto comum (px)<input type="number" min="9" max="20" value="{{nexus.layout.fontSize}}" data-global-typography="fontSize"></label>
            <label>Texto secundário (px)<input type="number" min="8" max="16" value="{{nexus.layout.secondaryFontSize}}" data-global-typography="secondaryFontSize"></label>
            <label>Valores em destaque (px)<input type="number" min="14" max="32" value="{{nexus.layout.valueFontSize}}" data-global-typography="valueFontSize"></label>
            <hr>
          </section>
          <section class="nexus-tool-panel nexus-component-editor" data-tool-panel="component" hidden>
            <h3>Propriedades</h3>
            <section class="nexus-component-inspector" hidden>
              <nav class="nexus-inspector-tabs" data-inspector-tabs aria-label="Propriedades do componente">
                <button type="button" class="active" data-inspector-tab="card">Dados</button>
                <button type="button" data-inspector-tab="appearance">Aparência</button>
                <button type="button" data-inspector-tab="advanced">Avançado</button>
              </nav>

              <div class="nexus-inspector-tab-panel active" data-inspector-tab-panel="card">
                <section class="nexus-inspector-section" data-component-identity>
                  <h4>Origem do nome</h4>
                  <label class="nexus-inspector-field" data-component-update-source hidden><input type="checkbox" data-component-setting="updateSource" checked> Permitir editar o nome original</label>
                </section>

                <section class="nexus-inspector-section" data-inspector-data>
                  <h4>Dados</h4>
                  <label class="nexus-inspector-field" data-component-text-row hidden>Conteúdo<textarea data-component-setting="text" rows="2"></textarea></label>
                  <div class="nexus-data-binding" data-component-data-row hidden>
                    <label class="nexus-inspector-field">Propriedade relacionada<input type="text" data-component-setting="dataPath" data-component-path-input autocomplete="off" spellcheck="false" aria-autocomplete="list" aria-controls="nexus-component-path-options-{{nexus.actor.id}}"></label>
                  </div>
                  <div class="nexus-property-options" id="nexus-component-path-options-{{nexus.actor.id}}" data-component-path-options hidden role="listbox" aria-label="Propriedades e atalhos disponíveis"></div>
                  <label class="nexus-inspector-field" data-property-value-row hidden>Valor da propriedade<input type="text" data-property-value autocomplete="off"></label>

                  <label class="nexus-inspector-field" data-component-placeholder-row hidden>Texto de orientação<input type="text" maxlength="100" data-component-setting="placeholder"></label>
                  <div class="nexus-inspector-grid" data-component-table-settings hidden>
                    <label class="nexus-inspector-field">Linhas<input type="number" min="1" max="20" data-component-setting="rows"></label>
                    <label class="nexus-inspector-field">Colunas<input type="number" min="1" max="12" data-component-setting="columns"></label>
                  </div>
                  <label class="nexus-inspector-field" data-component-resource-row hidden>Recurso<select data-component-setting="binding"><option value="">Sem vínculo</option><option value="pv">PV · Pontos de Vida</option><option value="pm">PM · Pontos de Mana</option><option value="pe">PE · Pontos de Energia</option><option value="custom">Personalizado</option></select></label>
                  <label class="nexus-inspector-field" data-component-custom-binding hidden>Propriedade do recurso<input type="text" data-component-setting="customBinding"></label>
                  <label class="nexus-inspector-field" data-component-custom-binding hidden>Nome do recurso<input type="text" maxlength="24" data-component-setting="resourceLabel"></label>
                  <label class="nexus-inspector-field" data-component-format-row hidden>Representação<select data-component-setting="format"><option value="classic">Clássica</option><option value="bar">Barra</option><option value="ring">Circular</option></select></label>
                  <section class="nexus-inspector-subsection" data-sheet-resource-config hidden>
                    <h5>Valores do indicador</h5>
                    <div class="nexus-inspector-grid nexus-resource-path-grid">
                      <label class="nexus-inspector-field">Valor atual<input type="text" data-component-setting="currentPath" list="nexus-resource-paths-{{nexus.actor.id}}"></label>
                      <label class="nexus-inspector-field">Valor máximo<input type="text" data-component-setting="maxPath" list="nexus-resource-paths-{{nexus.actor.id}}"></label>
                    </div>
                    <datalist id="nexus-resource-paths-{{nexus.actor.id}}" data-resource-path-list></datalist>
                  </section>
                  <section class="nexus-inspector-subsection" data-sheet-attribute-config hidden>
                    <label class="nexus-inspector-field">Atributo<select data-component-setting="attributePreset"><option value="for">Força</option><option value="des">Destreza</option><option value="sab">Sabedoria</option><option value="int">Inteligência</option><option value="car">Carisma</option><option value="von">Vontade</option><option value="custom">Personalizado</option></select></label>
                  </section>
                  <section class="nexus-inspector-subsection" data-numeric-resource-config hidden>
                    <div class="nexus-inspector-grid"><label class="nexus-inspector-field">Valor atual<input type="number" data-config-current-value></label><label class="nexus-inspector-field">Valor máximo<input type="number" data-config-max-value></label></div>
                  </section>

                  <section class="nexus-inspector-section nexus-token-data-editor" data-token-editor hidden>
                    <h4>Imagem do token</h4>
                    <div class="nexus-actor-portrait-preview"><img data-actor-portrait-preview src="{{actor.img}}" alt="Retrato do ator"></div>
                    <label class="nexus-inspector-field">Retrato do ator (diretório do Foundry)<input type="text" data-actor-portrait data-system-path="img" value="{{actor.img}}" autocomplete="off"></label>
                    <div class="nexus-token-subcanvas" data-token-preview data-shape="circle"><img class="nexus-token-portrait" src="{{component.value}}" alt="Prévia do token"></div>
                    <label class="nexus-inspector-field">Imagem do token<input type="text" data-component-setting="tokenImage" autocomplete="off"></label>
                    <button type="button" class="nexus-sync-token-portrait" data-sync-token-portrait><i class="fa-solid fa-image" aria-hidden="true"></i> Usar imagem do token como retrato</button>
                  </section>
                  <div class="nexus-data-media-preview" data-component-media-preview hidden aria-live="polite"></div>
                </section>

                <section class="nexus-inspector-section" data-inspector-layer-style hidden>
                  <h4>Camada</h4>
                  <label class="nexus-inspector-field">Ícone<input type="text" maxlength="120" data-component-setting="layerIcon"></label>
                  <label class="nexus-inspector-field">Imagem<input type="text" maxlength="2048" data-component-setting="layerImage"></label>
                </section>
                <section class="nexus-inspector-section" data-group-inspector hidden>
                  <h4>Grupo</h4>
                  <div class="nexus-inspector-grid"><label class="nexus-inspector-field">Fundo<nexus-color-picker data-group-setting="backgroundColor"></nexus-color-picker></label><label class="nexus-inspector-field">Borda<nexus-color-picker data-group-setting="borderColor"></nexus-color-picker></label><label class="nexus-inspector-field">Arredondamento<input type="number" min="0" max="32" data-group-setting="borderRadius"></label></div>
                  <button type="button" class="nexus-save-group-library" data-action="save-group-library"><i class="fa-solid fa-bookmark" aria-hidden="true"></i> Salvar grupo na Biblioteca</button>
                </section>
              </div>

              <div class="nexus-inspector-tab-panel" data-inspector-tab-panel="appearance" hidden>
                <section class="nexus-inspector-section" data-inspector-card-style>
                  <div class="nexus-inspector-section-heading"><h4>Cartão</h4><button type="button" data-component-reset="style">Restaurar</button></div>
                  <div class="nexus-inspector-grid"><label class="nexus-inspector-field">Fundo<span class="nexus-field-control-row"><nexus-color-picker data-component-setting="backgroundColor" value="#273443"></nexus-color-picker><button type="button" class="nexus-field-reset" data-component-setting-reset="backgroundColor">↺</button></span></label><label class="nexus-inspector-field">Borda<span class="nexus-field-control-row"><nexus-color-picker data-component-setting="borderColor" value="#52647b"></nexus-color-picker><button type="button" class="nexus-field-reset" data-component-setting-reset="borderColor">↺</button></span></label><label class="nexus-inspector-field">Cantos<span class="nexus-field-control-row"><input type="number" min="0" max="32" data-component-setting="borderRadius"><button type="button" class="nexus-field-reset" data-component-setting-reset="borderRadius">↺</button></span></label><label class="nexus-inspector-field">Opacidade (%)<span class="nexus-field-control-row"><input type="number" min="0" max="100" data-component-setting="opacity"><button type="button" class="nexus-field-reset" data-component-setting-reset="opacity">↺</button></span></label></div>
                  <div class="nexus-inspector-subsection"><h5>Posição e dimensões</h5><div class="nexus-inspector-grid"><label class="nexus-inspector-field">X<input type="number" min="0" data-component-setting="x"></label><label class="nexus-inspector-field">Y<input type="number" min="0" data-component-setting="y"></label><label class="nexus-inspector-field">Largura<input type="number" min="20" max="1000" data-component-setting="width"></label><label class="nexus-inspector-field">Altura<input type="number" min="20" max="1000" data-component-setting="height"></label></div></div>
                </section>
                <section class="nexus-inspector-section" data-inspector-component-style>
                  <div class="nexus-inspector-section-heading"><h4>Componente</h4><button type="button" data-component-reset="typography">Restaurar tipografia</button></div>
                  <div class="nexus-inspector-subsection" data-component-appearance-identity>
                    <h5>Identificação visual</h5>
                    <label class="nexus-inspector-field" data-component-custom-label>Rótulo do cartão<input type="text" maxlength="48" data-component-setting="customLabel" autocomplete="off"></label>
                    <label class="nexus-inspector-check" data-component-show-label><input type="checkbox" data-component-setting="showLabel" checked> Mostrar rótulo</label>
                  </div>
                  <section class="nexus-text-tools" data-text-tools hidden>
                    <h5>Formatação do texto</h5>
                    <div class="nexus-text-target-tabs"><button type="button" class="active" data-text-style-target="content" data-text-style-control="target-content">Conteúdo</button><button type="button" data-text-style-target="heading" data-text-style-control="target-heading">Título</button></div>
                    <div class="nexus-text-toolbar">
                      <button type="button" data-text-style-command="bold" data-text-style-control="bold" aria-label="Negrito" aria-pressed="false"><i class="fa-solid fa-bold"></i></button><button type="button" data-text-style-command="italic" data-text-style-control="italic" aria-label="Itálico" aria-pressed="false"><i class="fa-solid fa-italic"></i></button><button type="button" data-text-style-command="underline" data-text-style-control="underline" aria-label="Sublinhado" aria-pressed="false"><i class="fa-solid fa-underline"></i></button>
                      <span class="nexus-text-toolbar-divider"></span><button type="button" data-text-style-command="align-left" data-text-style-control="align-left" aria-label="Alinhar à esquerda"><i class="fa-solid fa-align-left"></i></button><button type="button" data-text-style-command="align-center" data-text-style-control="align-center" aria-label="Centralizar"><i class="fa-solid fa-align-center"></i></button><button type="button" data-text-style-command="align-right" data-text-style-control="align-right" aria-label="Alinhar à direita"><i class="fa-solid fa-align-right"></i></button>
                      <span class="nexus-text-toolbar-divider"></span><button type="button" data-text-style-menu-toggle data-text-style-control="font-menu" aria-label="Família da fonte"><i class="fa-solid fa-font"></i></button><div class="nexus-text-font-menu" data-text-style-font-menu hidden><button type="button" data-text-style-font="Inter" data-text-style-control="font-option">Inter</button><button type="button" data-text-style-font="Arial" data-text-style-control="font-option">Arial</button><button type="button" data-text-style-font="Georgia" data-text-style-control="font-option">Georgia</button><button type="button" data-text-style-font="Verdana" data-text-style-control="font-option">Verdana</button><button type="button" data-text-style-font="monospace" data-text-style-control="font-option">Monoespaçada</button></div>
                      <label class="nexus-text-size"><i class="fa-solid fa-text-height"></i><input type="number" min="7" max="48" data-text-style-size value="13" aria-label="Tamanho da fonte" data-text-style-control="font-size"></label><nexus-color-picker data-text-style-color data-text-style-control="text-color" value="#e7edf5"></nexus-color-picker><button type="button" data-text-style-command="transform" data-text-style-control="transform" aria-label="Alternar caixa do texto"><i class="fa-solid fa-text-size"></i></button><button type="button" data-text-style-advanced-toggle data-text-style-control="advanced" aria-label="Mais opções"><i class="fa-solid fa-sliders"></i></button>
                    </div>
                    <div class="nexus-text-advanced" data-text-style-advanced hidden><label>Espaçamento<input type="number" min="-2" max="12" step="0.5" data-text-style-field="letterSpacing" data-text-style-control="advanced-spacing"></label><label>Altura da linha<input type="number" min="0.8" max="2.4" step="0.1" data-text-style-field="lineHeight" data-text-style-control="advanced-line-height"></label></div>
                  </section>
remove legacy typography selects                  <label class="nexus-inspector-field" data-component-label-position>Posição do nome do cartão<select data-component-setting="labelPosition"><option value="top-left">Acima · à esquerda</option><option value="top-center">Acima · centralizado</option><option value="side-left">Ao lado · à esquerda</option></select></label>
                </section>
<section class="nexus-inspector-section" data-image-settings hidden><h4>Imagem</h4><div class="nexus-inspector-grid"><label class="nexus-inspector-field">Ajuste<select data-component-setting="imageFit"><option value="contain">Conter · preservar proporção</option><option value="cover">Recortar para preencher</option></select></label><label class="nexus-inspector-field">Posição<select data-component-setting="imagePosition"><option value="center">Centro</option><option value="top">Topo</option><option value="bottom">Base</option><option value="left">Esquerda</option><option value="right">Direita</option></select></label><label class="nexus-inspector-field">Opacidade (%)<input type="number" min="0" max="100" data-component-setting="imageOpacity"></label></div></section>
                 <section class="nexus-inspector-section" data-token-configuration hidden>
                  <h4>Moldura e sobreposição</h4>
                  <div class="nexus-inspector-grid"><label class="nexus-inspector-field">Tipo<select data-component-setting="tokenFrameMode"><option value="solid">Cor sólida</option><option value="media">Mídia</option></select></label><label class="nexus-inspector-field">Espessura<input type="number" min="0" max="16" data-component-setting="tokenFrameWidth"></label><label class="nexus-inspector-field">Cor<nexus-color-picker data-component-setting="tokenFrameColor"></nexus-color-picker></label></div>
                  <label class="nexus-inspector-field" data-token-frame-source-row>Mídia da moldura<input type="text" data-component-setting="tokenFrameSource"></label>
                  <label class="nexus-inspector-field">Sobreposição<input type="text" maxlength="24" data-component-setting="tokenOverlay"></label>
                  <div class="nexus-inspector-grid"><label class="nexus-inspector-field">Formato<select data-component-setting="tokenShape"><option value="circle">Circular</option><option value="rounded">Arredondado</option><option value="square">Quadrado</option></select></label><label class="nexus-inspector-field">Fundo<nexus-color-picker data-component-setting="tokenBackgroundColor"></nexus-color-picker></label></div>
                </section>
                <section class="nexus-inspector-section" data-sheet-resource-editor hidden>
                  <div class="nexus-inspector-section-heading"><h4>Indicador</h4><button type="button" data-component-reset="resource">Restaurar</button></div>
                  <div class="nexus-inspector-grid"><label class="nexus-inspector-field">Rótulo<input type="text" maxlength="24" data-component-setting="sheetContent1"></label><label class="nexus-inspector-field">Ícone<input type="text" maxlength="120" data-component-setting="sheetContent2"></label><label class="nexus-inspector-field">Preenchimento<nexus-color-picker data-component-setting="sheetColor"></nexus-color-picker></label><label class="nexus-inspector-field">Fundo da barra<nexus-color-picker data-component-setting="sheetTrackColor"></nexus-color-picker></label></div>
                  <label class="nexus-inspector-field">Orientação<select data-component-setting="sheetOrientation"><option value="horizontal">Horizontal</option><option value="vertical">Vertical</option></select></label>
                </section>
              </div>
              <div class="nexus-inspector-tab-panel" data-inspector-tab-panel="advanced" hidden>
                <section class="nexus-inspector-section" data-component-technical>
                  <h4>Identificação técnica</h4>
                  <label class="nexus-inspector-field">ID do componente<input type="text" data-component-technical-id readonly></label>
                  <label class="nexus-inspector-field">Tipo interno<input type="text" data-component-technical-type readonly></label>
                </section>
              </div>
            </section>
            <p class="nexus-inspector-empty">Selecione um único cartão no canvas ou na lista de camadas.</p>
          </section>
          <section class="nexus-tool-panel nexus-behavior-editor" data-tool-panel="behavior" hidden>
            <p class="nexus-behavior-empty" data-behavior-empty>Selecione um componente no Canvas ou em Organização para editar seus comportamentos.</p>
            <div data-interaction-editor data-component-id=""></div>
          </section>
          <section class="nexus-tool-panel nexus-alias-manager" data-tool-panel="aliases" hidden>
            <nav class="nexus-data-mode" aria-label="Tipo de dado">
              <button type="button" data-alias-mode="custom" class="{{#if (eq nexus.aliasEditorMode "custom")}}active{{/if}}">Campos próprios</button>
              <button type="button" data-alias-mode="native" class="{{#if (eq nexus.aliasEditorMode "native")}}active{{/if}}">Dados do sistema</button>
            </nav>
            {{#if (eq nexus.aliasEditorMode "native")}}
              <section class="nexus-alias-existing">
                <label>Propriedade original<select data-native-property-select>
                  <option value="" {{#unless nexus.selectedNativeProperty}}selected{{/unless}}>Selecione uma propriedade…</option>
                  {{#each nexus.nativeProperties as |property|}}<option value="{{property.id}}" {{#if (eq nexus.selectedNativeProperty.id property.id)}}selected{{/if}}>{{property.defaultLabel}} · {{property.defaultKey}}</option>{{/each}}
                </select></label>
                {{#if nexus.selectedNativeProperty}}
                  <article class="nexus-alias-card" data-native-property-row="{{nexus.selectedNativeProperty.id}}">
                    <div class="nexus-alias-native-source"><span>ORIGEM DO NEXUS</span><code>{{nexus.selectedNativeProperty.targetPath}}</code></div>
                    <div class="nexus-alias-card-grid">
                      <label>Nome exibido<input type="text" value="{{nexus.selectedNativeProperty.label}}" data-native-property-field="label"></label>
