                  <label>Formato<select data-alias-value-type><option value="number">Numérico</option><option value="text">Texto</option><option value="url">Link</option><option value="image">Imagem</option><option value="boolean">Sim / não</option></select></label>
                  <label>Origem<select data-alias-source><option value="custom">Armazenamento NEXUS</option><option value="actor">Campo do Actor</option></select></label>
                </div>
                <label data-alias-target-row hidden>Caminho no Actor<input type="text" data-alias-target spellcheck="false"></label>
