            </div>
            <nav class="nexus-library-section-tabs" aria-label="Categorias da biblioteca">
              <button type="button" class="active" data-library-section="assets"><i class="fa-solid fa-cubes" aria-hidden="true"></i> Assets</button>
              <button type="button" data-library-section="flows"><i class="fa-solid fa-diagram-project" aria-hidden="true"></i> Fluxos</button>
              <button type="button" data-library-section="themes"><i class="fa-solid fa-palette" aria-hidden="true"></i> Temas</button>
            </nav>
