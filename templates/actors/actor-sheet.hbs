                    <div class="nexus-library-personal-group"><div class="nexus-library-section-heading"><strong>Componentes</strong><span>Itens salvos individualmente</span></div><div class="nexus-library-personal-grid" data-library-saved-components></div></div>
                    <div class="nexus-library-personal-group"><div class="nexus-library-section-heading"><strong>Grupos</strong><span>Composições salvas</span></div><div class="nexus-library-saved-groups" data-library-saved-groups></div></div>
                  </section>
