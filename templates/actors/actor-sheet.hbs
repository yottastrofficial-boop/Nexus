            <div class="nexus-layer-list">{{#each nexus.layers as |layer|}}<div class="nexus-layer-folder {{#if layer.hidden}}is-hidden{{/if}} {{#if layer.locked}}is-locked{{/if}}">{{#if (eq layer.kind "group")}}<div class="nexus-layer-entry is-group"><button type="button" class="nexus-layer-row nexus-layer-group-row" data-layer-group="{{layer.id}}"><span class="nexus-layer-disclosure" data-layer-disclosure="{{layer.id}}">{{#if layer.collapsed}}▸{{else}}▾{{/if}}</span><span class="nexus-layer-thumbnail">{{#if layer.image}}<img src="{{layer.image}}" alt="">{{else if layer.icon}}<i class="{{layer.icon}}" aria-hidden="true"></i>{{else}}▱{{/if}}</span><span class="nexus-layer-name">{{layer.label}}</span><small>{{layer.z}}</small></button><button type="button" class="nexus-layer-state" data-layer-visibility="group:{{layer.id}}">{{#if layer.hidden}}◌{{else}}◉{{/if}}</button><button type="button" class="nexus-layer-state" data-layer-lock="group:{{layer.id}}">{{#if layer.locked}}🔒{{else}}♧{{/if}}</button></div><div class="nexus-layer-children" {{#if layer.collapsed}}hidden{{/if}}>{{#each layer.children as |child|}}<div class="nexus-layer-entry"><button type="button" class="nexus-layer-row nexus-layer-child-row" data-layer-select="{{child.id}}"><span class="nexus-layer-thumbnail">{{#if child.image}}<img src="{{child.image}}" alt="">{{else if child.icon}}<i class="{{child.icon}}" aria-hidden="true"></i>{{else}}▧{{/if}}</span><span class="nexus-layer-name">{{child.label}}</span><small>{{child.z}}</small></button><button type="button" class="nexus-layer-state" data-layer-visibility="component:{{child.id}}">{{#if child.hidden}}◌{{else}}◉{{/if}}</button><button type="button" class="nexus-layer-state" data-layer-lock="component:{{child.id}}">{{#if child.locked}}🔒{{else}}♧{{/if}}</button></div>{{/each}}</div>{{else}}<div class="nexus-layer-entry"><button type="button" class="nexus-layer-row" data-layer-select="{{layer.id}}"><span class="nexus-layer-thumbnail">{{#if layer.image}}<img src="{{layer.image}}" alt="">{{else if layer.icon}}<i class="{{layer.icon}}" aria-hidden="true"></i>{{else}}▧{{/if}}</span><span class="nexus-layer-name">{{layer.label}}</span><small>{{layer.z}}</small></button><button type="button" class="nexus-layer-state" data-layer-visibility="component:{{layer.id}}">{{#if layer.hidden}}◌{{else}}◉{{/if}}</button><button type="button" class="nexus-layer-state" data-layer-lock="component:{{layer.id}}">{{#if layer.locked}}🔒{{else}}♧{{/if}}</button></div>{{/if}}</div>{{/each}}</div>
          </section>
          <section class="nexus-tool-panel nexus-library-panel" data-tool-panel="library" hidden>
